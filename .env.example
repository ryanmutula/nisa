# ── The order desk ───────────────────────────────────────────────────
# The password the admin signs in with, at /admin. Without it the
# dashboard cannot be opened at all — it says so rather than letting
# anyone in. Make it long; it is the only thing standing between the
# internet and your order book.
ADMIN_PASSWORD=change-me-to-something-long

# Signs the admin session cookie. At least 16 characters of randomness —
# `openssl rand -base64 32` is a good way to get some. Production refuses
# to start without it. Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Where the order book is kept. The default is ./data/orders.json, which
# is fine on a normal server or a mounted volume. On a platform with an
# ephemeral or read-only filesystem (Vercel's serverless functions, most
# containers without a volume) point this at a mounted disk — or replace
# readAll/writeAll in lib/server/orders.ts with a database.
# ORDERS_FILE=/var/lib/nisa/orders.json

# ── The shop ─────────────────────────────────────────────────────────
# Contact, wholesale and newsletter post here. Get a free key at
# https://web3forms.com. While it is empty those three forms fall back to
# a prefilled WhatsApp message, so nothing is ever lost. Orders do not
# depend on it — checkout posts to /api/orders.
NEXT_PUBLIC_FORM_KEY=

# Used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://nisaparfums.com
